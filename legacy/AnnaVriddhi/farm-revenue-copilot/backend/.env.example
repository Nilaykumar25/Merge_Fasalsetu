# Backend environment variables
# Copy to .env and fill in real values — never commit .env

NODE_ENV=development
PORT=4000

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_revenue_copilot
DB_USER=postgres
DB_PASSWORD=changeme

# ── Auth ──
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Scheduled Jobs ──
# Cron schedule for crop state computation (default: every 6 hours)
CROP_STATE_JOB_SCHEDULE=0 */6 * * *
# Set to 'false' to prevent jobs from running on server startup
RUN_JOBS_ON_STARTUP=true
# Timezone for scheduled jobs
TZ=Asia/Kolkata

# ── Weather API ──
# Get your API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ── SMS / WhatsApp (Twilio) ──
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# For WhatsApp, use the same number with whatsapp: prefix

# ── Soil Health Card (SHC) API ──
SHC_API_BASE_URL=
SHC_API_KEY=

# ── Gemini API (for AI Advisor & localization) ──
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: AI-powered farmer advisory chatbot and multilingual localization
GEMINI_API_KEY=

# ── Redis (for job queue) ──
REDIS_URL=redis://localhost:6379
