# FasalSetu — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Mandatory ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-key-here
DATABASE_URL=postgresql://fasalsetu:password@localhost:5432/fasalsetu

# ── LLM model IDs (never hardcoded; always override here) ──────────────────
FS_MODEL_ORCHESTRATOR=gemini-2.5-flash
FS_MODEL_TRANSLATE=gemini-2.5-flash

# ── Country / locale ────────────────────────────────────────────────────────
FS_COUNTRY_CODE=IN          # ISO 3166-1 alpha-2; must match a country_packs/<cc>/ folder

# ── Delivery ────────────────────────────────────────────────────────────────
FS_DELIVERY_PROVIDER=mock   # mock | twilio
TWILIO_ACCOUNT_SID=         # Only required if FS_DELIVERY_PROVIDER=twilio
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── External data APIs ───────────────────────────────────────────────────────
OPENWEATHER_API_KEY=        # Free OWM tier; leave blank for seasonal fallback
CDSE_CLIENT_ID=             # Copernicus CDSE; leave blank for mock satellite data
CDSE_CLIENT_SECRET=

# ── Demo / seeding ───────────────────────────────────────────────────────────
FS_SEED_DEMO=false          # Set true to auto-seed deterministic demo data on startup

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*              # Comma-separated origins, or * for development

# ── Guardrail audit log ───────────────────────────────────────────────────────
GUARDRAIL_AUDIT_LOG=logs/guardrail_audit.jsonl
