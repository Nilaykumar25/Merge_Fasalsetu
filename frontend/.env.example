# Vite frontend environment variables
# Copy to .env and fill in real values — NEVER commit .env
# All VITE_ vars are BROWSER-EXPOSED — never put service role keys here

# ── Supabase (anon/public key only) ──
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_API_KEY=your_supabase_anon_key_here

# ── Gemini AI ──
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Weather ──
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here

# ── Backend API (FastAPI) ──
# Local: http://localhost:8000
# Production: https://your-backend.vercel.app
VITE_SOIL_NPK_API_URL=http://localhost:8000

# ── Disease Detection ML ──
VITE_MODEL_API_URL=http://localhost:5000/predict

# ── Firebase (for Google Auth) ──
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Feature flags ──
VITE_ENABLE_GEMINI_AI=true
VITE_ENABLE_VOICE_FEATURES=true
VITE_ENABLE_FIREBASE=true
VITE_ENABLE_VIDEO_FEATURES=false
VITE_ENABLE_ADVANCED_ANALYTICS=false
VITE_ENABLE_CRISIS_DETECTION=false
VITE_ENABLE_CHIRP3_HD_VOICES=false
VITE_APP_ENV=production
VITE_DEBUG=false
